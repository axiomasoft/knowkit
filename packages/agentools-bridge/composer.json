{
  "name": "knowkit/agentools-bridge",
  "description": "Optional pinned AgenTools compatibility and exact legacy identity adapter",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "agentools/platform-core": "dev-pinned",
    "knowkit/core": "dev-main"
  },
  "require-dev": {"phpunit/phpunit": "^11.5"},
  "repositories": [
    {"type": "path", "url": "../core", "options": {"symlink": false, "versions": {"knowkit/core": "dev-main"}}},
    {
      "type": "package",
      "package": {
        "name": "agentools/platform-core",
        "version": "dev-pinned",
        "type": "library",
        "license": "proprietary",
        "source": {
          "type": "git",
          "url": "https://github.com/axiomasoft/agentools.git",
          "reference": "2054acda51eb69eca1579c78900858c5ff3de01e"
        },
        "require": {"php": ">=8.3"},
        "autoload": {"psr-4": {"AgenToolsPlatform\\Core\\": "packages/agentools-core/src/"}}
      }
    }
  ],
  "autoload": {"psr-4": {"KnowKit\\Bridge\\AgenTools\\": "src/"}},
  "autoload-dev": {"psr-4": {"KnowKit\\Bridge\\AgenTools\\Testing\\ContractFixture\\": "tests/ContractFixture/"}},
  "config": {"allow-plugins": false, "sort-packages": true, "platform": {"php": "8.4.0"}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
