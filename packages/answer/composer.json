{
  "name": "knowkit/answer",
  "description": "Optional bounded grounded-answer contracts and explicit model transport bindings",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=8.3",
    "knowkit/core": "dev-main",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../core",
      "options": {
        "symlink": false,
        "versions": {
          "knowkit/core": "dev-main"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "KnowKit\\Answer\\": "src/"
    }
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    }
  },
  "archive": {
    "exclude": [
      "/tests",
      "/vendor"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
