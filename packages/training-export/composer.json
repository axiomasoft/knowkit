{
  "name": "knowkit/training-export",
  "description": "Rights-gated, PII-redacted, deterministic dataset export and reward verification for KnowKit",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=8.3",
    "knowkit/context-compilers": "dev-main",
    "knowkit/core": "dev-main"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../core",
      "options": {
        "symlink": false,
        "versions": {
          "knowkit/core": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "../context-compilers",
      "options": {
        "symlink": false,
        "versions": {
          "knowkit/context-compilers": "dev-main"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "KnowKit\\TrainingExport\\": "src/"
    }
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    }
  },
  "archive": {
    "exclude": [
      "/tests",
      "/vendor"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
