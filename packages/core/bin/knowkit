#!/usr/bin/env php
<?php

declare(strict_types=1);

// This file can run directly from a checkout or an installed Composer package.
// Bootstrap path is host-owned environment, never command/model input.
ini_set('display_errors', '0');
ini_set('log_errors', '0');
ob_start();
try {
    $autoloaders = [dirname(__DIR__, 3) . '/vendor/autoload.php', dirname(__DIR__, 3) . '/autoload.php'];
    foreach ($autoloaders as $autoloader) {
        if (is_file($autoloader)) {
            require_once $autoloader;
            break;
        }
    }
    // Source checkout fallback; core has no vendor runtime dependencies.
    spl_autoload_register(static function (string $class): void {
        if (str_starts_with($class, 'KnowKit\\')) {
            $path = dirname(__DIR__) . '/src/' . str_replace('\\', '/', substr($class, 8)) . '.php';
            if (is_file($path)) {
                require_once $path;
            }
        }
    }, true, true);
    // Validate before loading host configuration, including when it is unavailable.
    $arguments = array_slice($argv, 1);
    $stdin = '';
    if (in_array('-', $arguments, true) || in_array('--input=-', $arguments, true)) {
        $raw = stream_get_contents(STDIN, 65537);
        $stdin = is_string($raw) ? $raw : '';
    }
    $host = getenv('KNOWKIT_HOST_BOOTSTRAP');
    $kernel = new KnowKit\Adapter\Cli\Kernel(static function ($command) use ($host) {
        if (!is_string($host) || str_contains($host, '://') || !is_file($host)) {
            throw new KnowKit\Domain\DomainFailure(KnowKit\Domain\Outcome::Unavailable, 'host_not_configured');
        }
        $dispatch = require $host;
        if (!$dispatch instanceof Closure) {
            throw new LogicException('Host dispatcher required');
        }

        return $dispatch($command);
    });
    $response = $kernel->run($arguments, $stdin);
    $json = $response->json();
    $exit = $response->exit;
} catch (Throwable) {
    $json = "{\"outcome\":\"error\",\"error\":{\"code\":\"internal_error\",\"retryable\":false},\"degraded\":false,\"warnings\":[]}\n";
    $exit = 70;
}
ob_end_clean();
fwrite(STDOUT, $json);
if ($exit !== 0) {
    fwrite(STDERR, "knowkit: request failed (exit {$exit})\n");
}
exit($exit);
