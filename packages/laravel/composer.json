{
  "name": "knowkit/laravel",
  "description": "Explicit Laravel delivery integration for the independent KnowKit core",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=8.3",
    "illuminate/bus": "^12.0",
    "illuminate/console": "^12.0",
    "illuminate/http": "^12.0",
    "illuminate/routing": "^12.0",
    "illuminate/support": "^12.0",
    "knowkit/core": "dev-main"
  },
  "require-dev": {
    "laravel/framework": "^12.0",
    "phpunit/phpunit": "^11.5"
  },
  "suggest": {
    "knowkit/http": "Optional versioned HTTP API implementation",
    "knowkit/answer": "Optional grounded answer use cases"
  },
  "repositories": [{"type": "path", "url": "../core", "options": {"symlink": false, "versions": {"knowkit/core": "dev-main"}}}],
  "autoload": {"psr-4": {"KnowKit\\Laravel\\": "src/"}},
  "config": {"allow-plugins": false, "sort-packages": true, "platform": {"php": "8.3.0"}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
