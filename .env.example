# Optional local test connection. No application credentials or model keys.
TEST_PG_DSN=pgsql:host=127.0.0.1;port=55432;dbname=knowkit_test
TEST_PG_USER=knowkit_test
TEST_PG_PORT=55432
# Target PostgreSQL 17+ image.
TEST_POSTGRES_IMAGE=postgres:17
TEST_NETWORK_SUBNET=10.235.90.0/28
# Optional vector profile. Loopback only; same disposable trust/tmpfs contract as postgres.
TEST_VECTOR_PORT=55433
TEST_VECTOR_IMAGE=pgvector/pgvector:pg17
TEST_VECTOR_PG_DSN=pgsql:host=127.0.0.1;port=55433;dbname=knowkit_test
# tmpfs mount, not a volume. PostgreSQL 18+ images store data under /var/lib/postgresql.
TEST_PG_TMPFS=/var/lib/postgresql/data
TEST_VECTOR_TMPFS=/var/lib/postgresql/data
