  "existingCoreReuse": [
    "Adapter/Postgres/Catalog/PdoCatalogTransaction: tenant serialization and bounded transactions",
    "Adapter/LocalBlob/PrivateFilesystem: private root, symlink/owner checks and streaming digest verification; directory enumeration now stops without materializing an unbounded scandir result",
    "Adapter/Postgres/IndexGenerations/ResourceInventory and PdoReadBackend: exact immutable manifests/resources and complete FTS readback",
    "Domain/ManifestCandidate and IndexManifest: unchanged approved index-manifest wire schema",
    "Existing restore_receipts/tombstones/serving_state: restore proof and disclosure barriers",
    "Existing P3.6 resource/deletion ledger: unknown obligations invalidate done; reconciliation does not fabricate erasure receipts"
  ],
  "sourceGaps": [
    {
      "gap": "Neither donor implements the KnowKit backup header or object/ledger/manifest/outbox bounded recovery protocol.",
      "resolution": "New vendor-free typed RecoveryPlan/RecoveryEvidence/ReconciliationStore and one-page PHP application orchestration preserve the existing package boundaries."
    },
    {
      "gap": "Authoritative external journal, provider exact-version verification and host disclosure canary cannot be invented by core.",
      "resolution": "Mandatory host callbacks/port contract; missing external verifier returns unknown, missing/incomplete journal or failed canary leaves readiness blocked. Canonical set loading is outside SQL."
    },
    {
      "gap": "Local inventory is the established compact profile, not an unbounded provider enumeration.",
      "resolution": "Explicit 10,000-entry/depth-5 cap with <=100 returned rows and durable keyset checkpoints; overflow fails closed. Larger stores need a stable bounded inventory adapter."
    },
    {
      "gap": "A projection can be absent in a backup while historical identities must remain immutable.",
      "resolution": "Only derived lexical rows may be rebuilt inside the matching blocked restore transaction; verify exact manifest/resources and full readback, retain immutable memberships/snapshots/citations."
    }
  ],
