{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowkit:schema:locator-vectors:1.0",
  "title": "Cross-language locator conversion, bbox normalization and span resolution vectors",
  "x-knowkit-maxDocumentBytes": 1048576,
  "x-knowkit-schemaVersion": "locator-vectors-1.0",
  "type": "object",
  "required": ["schemaVersion", "vectors"],
  "properties": {
    "schemaVersion": {"const": "locator-vectors-1.0"},
    "vectors": {"type": "array", "minItems": 1, "maxItems": 1024, "x-knowkit-uniqueBy": "id", "items": {"$ref": "#/$defs/vector"}}
  },
  "unevaluatedProperties": false,
  "$defs": {
    "vector": {
      "type": "object",
      "required": ["id", "op", "input"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"},
        "op": {"enum": ["page_index_to_locator", "normalize_bbox", "resolve_span"]},
        "input": {"type": "object"},
        "expected": true,
        "expectedErrorCode": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/code"},
        "note": {"type": "string", "maxLength": 512}
      },
      "allOf": [
        {
          "if": {"required": ["expectedErrorCode"]},
          "then": {"properties": {"expected": false}},
          "else": {"required": ["expected"]}
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
