{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowkit:schema:layer-stack:1.0",
  "title": "KnowKit ResolvedLayerStack 1.0",
  "x-knowkit-maxDocumentBytes": 1048576,
  "x-knowkit-schemaVersion": "layer-stack:1",
  "type": "object",
  "required": [
    "schemaVersion", "tenantId", "stackId", "nodes",
    "lockedKeyOwners", "effectiveDenySelectors",
    "staticPrefixDigest", "sessionPrefixDigest", "stackDigest"
  ],
  "properties": {
    "schemaVersion": {"const": "layer-stack:1"},
    "tenantId": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/ulid"},
    "stackId": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/ulid"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "layerId", "dependsOnLayerIds", "trustTier", "deliveryMode",
          "mergeStrategy", "disclosureMode", "lockedKeys", "ruleValues",
          "denySelectors", "budget", "backing", "nodeDigest"
        ],
        "properties": {
          "layerId": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/layerId"},
          "dependsOnLayerIds": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/layerId"}
          },
          "trustTier": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/trustTier"},
          "deliveryMode": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/deliveryMode"},
          "mergeStrategy": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/mergeStrategy"},
          "disclosureMode": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/disclosureMode"},
          "lockedKeys": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}(\\.[a-z][a-z0-9_]{0,31}){0,3}$"}
          },
          "ruleValues": {
            "type": "object",
            "maxProperties": 64,
            "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}(\\.[a-z][a-z0-9_]{0,31}){0,3}$"},
            "additionalProperties": {"type": ["string", "integer", "boolean"], "maxLength": 256}
          },
          "denySelectors": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/localId"}
          },
          "budget": {
            "type": "object",
            "required": ["minGuaranteedTokens", "maxCeilingTokens", "maxBytes", "weightBps", "preferredTier", "compactFallbackTier"],
            "properties": {
              "minGuaranteedTokens": {"type": "integer", "minimum": 0, "maximum": 1048576},
              "maxCeilingTokens": {"type": "integer", "minimum": 1, "maximum": 1048576},
              "maxBytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
              "weightBps": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/positiveBps"},
              "preferredTier": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/resolutionTier"},
              "compactFallbackTier": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/resolutionTier"}
            },
            "unevaluatedProperties": false,
            "x-knowkit-lessThan": {"code": "limit_exceeded", "orEqual": true, "pairs": [["minGuaranteedTokens", "maxCeilingTokens"]]}
          },
          "backing": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {"enum": ["directive", "snapshot", "catalog_mount", "tool_catalog", "overlay"]},
              "directiveId": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/ulid"},
              "directiveDigest": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/sha256"},
              "snapshotRef": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/snapshotRef"},
              "catalogMountId": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/ulid"},
              "catalogTenantId": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/ulid"},
              "mountGrantDigest": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/sha256"},
              "serverIds": {"type": "array", "maxItems": 32, "items": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/localId"}},
              "overlayKey": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/localId"}
            },
            "unevaluatedProperties": false
          },
          "nodeDigest": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/sha256"}
        },
        "unevaluatedProperties": false
      }
    },
    "lockedKeyOwners": {
      "type": "object",
      "maxProperties": 256,
      "additionalProperties": {
        "type": "object",
        "required": ["layerId", "valueDigest"],
        "properties": {
          "layerId": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/layerId"},
          "valueDigest": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/sha256"}
        },
        "unevaluatedProperties": false
      }
    },
    "effectiveDenySelectors": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/localId"}
    },
    "staticPrefixDigest": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/sha256"},
    "sessionPrefixDigest": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/sha256"},
    "stackDigest": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/sha256"}
  },
  "unevaluatedProperties": false
}
