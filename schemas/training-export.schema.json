{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowkit:schema:training-export:1.0",
  "title": "KnowKit TrainingExportManifest 1.0",
  "x-knowkit-maxDocumentBytes": 1048576,
  "x-knowkit-schemaVersion": "training-export:1",
  "type": "object",
  "required": [
    "schemaVersion", "exportId", "tenantId", "format", "createdAt",
    "layerStackDigests", "snapshotRefs", "shards",
    "includedCount", "excludedCountsByReason", "piiRedactorId", "manifestDigest"
  ],
  "properties": {
    "schemaVersion": {"const": "training-export:1"},
    "exportId": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/ulid"},
    "tenantId": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/ulid"},
    "format": {"enum": ["distill-pairs-v1", "sft-grounded-v1", "grpo-tasks-v1"]},
    "createdAt": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/utcInstant"},
    "layerStackDigests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/sha256"}
    },
    "snapshotRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/snapshotRef"}
    },
    "shards": {
      "type": "array",
      "maxItems": 1024,
      "x-knowkit-sortedBy": ["path"],
      "items": {
        "type": "object",
        "required": ["path", "recordCount", "sha256", "byteLength"],
        "properties": {
          "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]{1,256}$"},
          "recordCount": {"type": "integer", "minimum": 0, "maximum": 10000000},
          "sha256": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/sha256"},
          "byteLength": {"type": "integer", "minimum": 0, "maximum": 1073741824}
        },
        "unevaluatedProperties": false
      }
    },
    "includedCount": {"type": "integer", "minimum": 0, "maximum": 10000000},
    "excludedCountsByReason": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/errorCode"},
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 10000000}
    },
    "piiRedactorId": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/profileId"},
    "manifestDigest": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/sha256"}
  },
  "unevaluatedProperties": false
}
