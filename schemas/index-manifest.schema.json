{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowkit:schema:index-manifest:1.0",
  "title": "Sealed IndexManifest",
  "description": "manifestDigest = SHA256('knowkit:index-manifest:v1' || 0x00 || JCS(manifest)). Members and resources are sorted by their full tuple IDs; span order inside chunks is never reordered.",
  "x-knowkit-maxDocumentBytes": 16777216,
  "x-knowkit-schemaVersion": "index-manifest-1.0",
  "type": "object",
  "required": ["schemaVersion", "tenantId", "kbId", "generationId", "profile", "members", "resources", "coverage", "counts", "embeddingSpaceDigest"],
  "properties": {
    "schemaVersion": {"const": "index-manifest-1.0"},
    "tenantId": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/ulid"},
    "kbId": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/ulid"},
    "generationId": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/ulid"},
    "profile": {
      "type": "object",
      "required": ["id", "kind", "parserSignature", "chunkerSignature"],
      "properties": {
        "id": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/profileId"},
        "kind": {"enum": ["lexical", "vector"]},
        "parserSignature": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/parserSignature"},
        "chunkerSignature": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/parserSignature"}
      },
      "unevaluatedProperties": false
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "x-knowkit-sortedBy": ["sourceId", "sourceVersionId", "documentRevisionId", "chunkSetId"],
      "items": {
        "type": "object",
        "required": ["sourceId", "sourceVersionId", "sourceDigest", "documentRevisionId", "irDigest", "chunkSetId", "chunkSetDigest", "chunkCount"],
        "properties": {
          "sourceId": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/ulid"},
          "sourceVersionId": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/ulid"},
          "sourceDigest": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/sha256"},
          "documentRevisionId": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/ulid"},
          "irDigest": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/sha256"},
          "chunkSetId": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/ulid"},
          "chunkSetDigest": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/sha256"},
          "chunkCount": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/uint32"}
        },
        "unevaluatedProperties": false
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 100000,
      "x-knowkit-sortedBy": ["resourceId"],
      "items": {
        "type": "object",
        "required": ["resourceId", "kind", "digest", "byteLength"],
        "properties": {
          "resourceId": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/ulid"},
          "kind": {"enum": ["ir", "canonical_slice", "asset", "lexical_index", "vector_index"]},
          "digest": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/sha256"},
          "byteLength": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/uint64String"}
        },
        "unevaluatedProperties": false
      }
    },
    "coverage": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/coverage"},
    "counts": {
      "type": "object",
      "required": ["members", "chunks", "resources"],
      "properties": {
        "members": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/uint32"},
        "chunks": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/uint32"},
        "resources": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/uint32"}
      },
      "unevaluatedProperties": false
    },
    "embeddingSpaceDigest": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/nullableSha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"profile": {"properties": {"kind": {"const": "vector"}}, "required": ["kind"]}}, "required": ["profile"]},
      "then": {"properties": {"embeddingSpaceDigest": {"type": "string"}}},
      "else": {"properties": {"embeddingSpaceDigest": {"type": "null"}}}
    }
  ],
  "unevaluatedProperties": false
}
