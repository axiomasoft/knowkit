{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowkit:schema:binding-vectors:1.0",
  "title": "Cross-document trusted scope and selection binding vectors",
  "x-knowkit-maxDocumentBytes": 1048576,
  "x-knowkit-schemaVersion": "binding-vectors-1.0",
  "type": "object",
  "required": ["schemaVersion", "vectors"],
  "properties": {
    "schemaVersion": {"const": "binding-vectors-1.0"},
    "vectors": {"type": "array", "minItems": 1, "maxItems": 1024, "x-knowkit-uniqueBy": "id", "items": {"$ref": "#/$defs/vector"}}
  },
  "unevaluatedProperties": false,
  "$defs": {
    "vector": {
      "type": "object",
      "required": ["id", "op", "input", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"},
        "op": {"enum": ["scope_selection", "disclosure_selection"]},
        "input": {"type": "object"},
        "expected": {
          "type": "object",
          "required": ["outcome"],
          "properties": {
            "outcome": {"enum": ["success", "denied"]},
            "code": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/errorCode"}
          },
          "allOf": [{"if": {"properties": {"outcome": {"const": "denied"}}, "required": ["outcome"]}, "then": {"required": ["code"]}, "else": {"properties": {"code": false}}}],
          "unevaluatedProperties": false
        },
        "note": {"type": "string", "maxLength": 512}
      },
      "unevaluatedProperties": false
    }
  }
}
