{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowkit:schema:decision-receipt:1.0",
  "title": "DecisionReceipt of AccessPolicy::decide / EgressPolicy::mayEgress",
  "description": "receiptDigest = SHA256('knowkit:decision-receipt:v1' || 0x00 || JCS(receipt without receiptDigest)).",
  "x-knowkit-maxDocumentBytes": 1048576,
  "type": "object",
  "required": ["decision", "operation", "resourceRefs", "binding", "ownerRevision", "checkedAt", "expiresAt", "receiptDigest", "hostScopeHash"],
  "properties": {
    "decision": {"enum": ["Allow", "Deny", "Unknown"]},
    "operation": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/operation"},
    "resourceRefs": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/tenantScopedRef"}},
    "binding": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/policyBinding"},
    "ownerRevision": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "checkedAt": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/utcInstant"},
    "expiresAt": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/utcInstant"},
    "receiptDigest": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/sha256"},
    "hostScopeHash": {"$ref": "urn:knowkit:schema:common:1.0#/$defs/hostScopeHash"}
  },
  "unevaluatedProperties": false
}
