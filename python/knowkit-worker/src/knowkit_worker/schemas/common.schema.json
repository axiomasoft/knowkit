{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowkit:schema:common:1.0",
  "title": "KnowKit shared wire definitions 1.0",
  "description": "Definitions only; not a document root. Normative rules: specs/contracts/wire-contract.md.",
  "$defs": {
    "ulid": {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "nullableUlid": {"type": ["string", "null"], "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "hostScopeHash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Trusted opaque SHA-256 supplied by the host; never recomputed or retagged."},
    "decimalBigint": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,18})$", "x-knowkit-decimalMax": "9223372036854775807"},
    "uint64String": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$", "x-knowkit-decimalMax": "18446744073709551615"},
    "uint32": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "localId": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "nullableLocalId": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "localIds": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/localId"}},
    "utcInstant": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"},
    "nullableUtcInstant": {"type": ["string", "null"], "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"},
    "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "codes": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/code"}},
    "errorCode": {"type": "string", "pattern": "^([a-z][a-z0-9_]{0,63}|[A-Z][A-Z0-9_]{0,63})$", "description": "Wire error code kept in its approved original case: lower snake_case (scope_mismatch) or UPPER_SNAKE_CASE (POLICY_CHANGED, RETRYABLE_LOCK_TIMEOUT). Mixed case is rejected; no case conversion is applied."},
    "profileId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "shortText": {"type": "string", "minLength": 1, "maxLength": 256},
    "purpose": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}(\\.[a-z][a-z0-9_]{0,31}){1,3}$", "description": "Host business purpose such as lesson.read; never an Operation value."},
    "operation": {"enum": ["retrieve", "disclose", "publish", "model_egress_context", "navigate", "catalog_create", "collection_create", "membership_mutate", "source_register", "source_version_add", "ingest", "reprocess", "job_cancel", "lifecycle_correct", "lifecycle_revoke", "lifecycle_delete", "legal_hold_set", "purge_status", "provider_acceptance", "diagnostics", "layer_resolve", "directive_promote", "catalog_mount", "training_export"]},
    "outcome": {"enum": ["success", "empty", "denied", "unknown", "unavailable", "incompatible"]},
    "origin": {"enum": ["source", "ocr", "generated", "deterministic"]},
    "provenanceKind": {"enum": ["verbatim", "table_representation", "description", "summary", "pruned_verbatim_subspans", "navigation_outline", "proposition_set"]},
    "instanceId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
    "layerId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"},
    "bps": {"type": "integer", "minimum": 0, "maximum": 10000},
    "positiveBps": {"type": "integer", "minimum": 1, "maximum": 10000},
    "permille": {"type": "integer", "minimum": 0, "maximum": 1000},
    "trustTier": {"enum": ["trusted_directive", "curated_reference", "untrusted_evidence", "dynamic_overlay"]},
    "deliveryMode": {"enum": ["pinned_prefix", "session_pinned", "hybrid_retrievable", "tool_discoverable", "volatile_suffix"]},
    "mergeStrategy": {"enum": ["immutable_seal", "guarded_extend", "override_allowed", "weighted_mix", "exclusion_deny"]},
    "resolutionTier": {"enum": ["R0", "R1", "R2", "R3"]},
    "disclosureMode": {"enum": ["verbatim_allowed", "derived_only", "summary_only", "metadata_only", "index_only"]},
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}(\\.[a-z][a-z0-9_]{0,31}){1,3}$"},
      "additionalProperties": {"type": ["string", "integer", "boolean"], "maxLength": 256}
    },
    "parserSignature": {
      "type": "object",
      "required": ["name", "version", "profileDigest"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "profileDigest": {"$ref": "#/$defs/sha256"}
      },
      "unevaluatedProperties": false
    },
    "exactSourceRef": {
      "type": "object",
      "required": ["tenantId", "sourceId", "sourceVersionId", "sourceDigest"],
      "properties": {
        "tenantId": {"$ref": "#/$defs/ulid"},
        "sourceId": {"$ref": "#/$defs/ulid"},
        "sourceVersionId": {"$ref": "#/$defs/ulid"},
        "sourceDigest": {"$ref": "#/$defs/sha256"}
      },
      "unevaluatedProperties": false
    },
    "documentRevisionRef": {
      "type": "object",
      "required": ["tenantId", "sourceId", "sourceVersionId", "sourceDigest", "documentRevisionId", "irDigest", "parserSignature"],
      "properties": {
        "tenantId": {"$ref": "#/$defs/ulid"},
        "sourceId": {"$ref": "#/$defs/ulid"},
        "sourceVersionId": {"$ref": "#/$defs/ulid"},
        "sourceDigest": {"$ref": "#/$defs/sha256"},
        "documentRevisionId": {"$ref": "#/$defs/ulid"},
        "irDigest": {"$ref": "#/$defs/sha256"},
        "parserSignature": {"$ref": "#/$defs/parserSignature"}
      },
      "unevaluatedProperties": false
    },
    "chunkRef": {
      "type": "object",
      "required": ["tenantId", "sourceId", "sourceVersionId", "sourceDigest", "documentRevisionId", "irDigest", "parserSignature", "chunkSetId", "chunkId", "chunkDigest"],
      "properties": {
        "tenantId": {"$ref": "#/$defs/ulid"},
        "sourceId": {"$ref": "#/$defs/ulid"},
        "sourceVersionId": {"$ref": "#/$defs/ulid"},
        "sourceDigest": {"$ref": "#/$defs/sha256"},
        "documentRevisionId": {"$ref": "#/$defs/ulid"},
        "irDigest": {"$ref": "#/$defs/sha256"},
        "parserSignature": {"$ref": "#/$defs/parserSignature"},
        "chunkSetId": {"$ref": "#/$defs/ulid"},
        "chunkId": {"$ref": "#/$defs/ulid"},
        "chunkDigest": {"$ref": "#/$defs/sha256"}
      },
      "unevaluatedProperties": false
    },
    "chunkRefs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/chunkRef"}},
    "snapshotRef": {
      "type": "object",
      "required": ["tenantId", "kbId", "snapshotId", "manifestDigest"],
      "properties": {
        "tenantId": {"$ref": "#/$defs/ulid"},
        "kbId": {"$ref": "#/$defs/ulid"},
        "snapshotId": {"$ref": "#/$defs/ulid"},
        "manifestDigest": {"$ref": "#/$defs/sha256"}
      },
      "unevaluatedProperties": false
    },
    "tenantScopedRef": {
      "type": "object",
      "required": ["tenantId", "kind", "id"],
      "properties": {
        "tenantId": {"$ref": "#/$defs/ulid"},
        "kind": {"enum": ["knowledge_base", "collection", "source", "source_version", "document_revision", "chunk_set", "chunk", "generation", "snapshot", "job", "resource", "selection", "usage", "deletion_task", "directive_artifact", "layer_definition", "layer_stack", "catalog_mount", "resolution_manifest", "training_export"]},
        "id": {"$ref": "#/$defs/ulid"}
      },
      "unevaluatedProperties": false
    },
    "bbox": {
      "type": "object",
      "required": ["space", "origin", "view", "x0", "y0", "x1", "y1"],
      "properties": {
        "space": {"const": "page-millionths-top-left-v1"},
        "origin": {"const": "top-left"},
        "view": {"const": "rotated-page"},
        "x0": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "y0": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "x1": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "y1": {"type": "integer", "minimum": 0, "maximum": 1000000}
      },
      "unevaluatedProperties": false,
      "x-knowkit-lessThan": {"code": "invalid_bbox", "pairs": [["x0", "x1"], ["y0", "y1"]]}
    },
    "textLocatorFields": {
      "description": "Open tagged page/segment union; wrap with unevaluatedProperties=false.",
      "type": "object",
      "required": ["kind", "blockId", "byteStart", "byteEnd"],
      "properties": {
        "kind": {"enum": ["page", "segment"]},
        "blockId": {"$ref": "#/$defs/localId"},
        "byteStart": {"$ref": "#/$defs/uint32"},
        "byteEnd": {"$ref": "#/$defs/uint32"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "page"}}, "required": ["kind"]},
          "then": {
            "required": ["pageId", "physicalNo", "printedLabel"],
            "properties": {
              "pageId": {"$ref": "#/$defs/localId"},
              "physicalNo": {"type": "integer", "minimum": 1, "maximum": 4294967295},
              "printedLabel": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
              "bbox": {"$ref": "#/$defs/bbox"},
              "segmentId": false
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "segment"}}, "required": ["kind"]},
          "then": {
            "required": ["segmentId"],
            "properties": {
              "segmentId": {"$ref": "#/$defs/localId"},
              "pageId": false,
              "physicalNo": false,
              "printedLabel": false,
              "bbox": false
            }
          }
        }
      ],
      "x-knowkit-lessThan": {"code": "invalid_span", "pairs": [["byteStart", "byteEnd"]]}
    },
    "textLocator": {"$ref": "#/$defs/textLocatorFields", "unevaluatedProperties": false},
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity"],
      "properties": {
        "segmentId": {"$ref": "#/$defs/localId"},
        "code": {"$ref": "#/$defs/code"},
        "severity": {"enum": ["info", "warning", "error"]}
      },
      "unevaluatedProperties": false
    },
    "diagnostics": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/diagnostic"}},
    "coverage": {
      "type": "object",
      "required": ["state", "counts", "missingFeatures", "diagnostics"],
      "properties": {
        "state": {"enum": ["complete", "partial", "unknown"]},
        "counts": {
          "type": "object",
          "required": ["processed", "empty", "failed", "skipped"],
          "properties": {
            "expected": {"$ref": "#/$defs/uint32"},
            "processed": {"$ref": "#/$defs/uint32"},
            "empty": {"$ref": "#/$defs/uint32"},
            "failed": {"$ref": "#/$defs/uint32"},
            "skipped": {"$ref": "#/$defs/uint32"}
          },
          "unevaluatedProperties": false
        },
        "missingFeatures": {"$ref": "#/$defs/codes"},
        "diagnostics": {"$ref": "#/$defs/diagnostics"}
      },
      "unevaluatedProperties": false
    },
    "policyBinding": {
      "type": "object",
      "required": ["tenantPolicyEpoch", "kbPolicyEpoch", "sources"],
      "properties": {
        "tenantPolicyEpoch": {"$ref": "#/$defs/decimalBigint"},
        "kbPolicyEpoch": {"$ref": "#/$defs/decimalBigint"},
        "sources": {
          "type": "array",
          "maxItems": 4096,
          "x-knowkit-sortedBy": ["sourceId"],
          "items": {
            "type": "object",
            "required": ["sourceId", "sourcePolicyEpoch", "lifecycleEpoch"],
            "properties": {
              "sourceId": {"$ref": "#/$defs/ulid"},
              "sourcePolicyEpoch": {"$ref": "#/$defs/decimalBigint"},
              "lifecycleEpoch": {"$ref": "#/$defs/decimalBigint"}
            },
            "unevaluatedProperties": false
          }
        }
      },
      "unevaluatedProperties": false
    },
    "embeddingSpace": {
      "type": "object",
      "required": ["provider", "model", "revision", "dimensions", "normalization", "indexVersion", "documentRole", "queryRole"],
      "properties": {
        "provider": {"$ref": "#/$defs/name"},
        "model": {"$ref": "#/$defs/name"},
        "revision": {"type": "string", "minLength": 1, "maxLength": 128},
        "dimensions": {"type": "integer", "minimum": 1, "maximum": 65536},
        "normalization": {"enum": ["none", "l2"]},
        "indexVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "documentRole": {"type": "string", "minLength": 1, "maxLength": 64},
        "queryRole": {"type": "string", "minLength": 1, "maxLength": 64},
        "storageFormat": {"enum": ["float32", "halfvec", "binary_quantized"]},
        "mrlSourceDimensions": {"type": ["integer", "null"], "minimum": 1, "maximum": 65536}
      },
      "unevaluatedProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "retryable"],
      "properties": {
        "code": {"$ref": "#/$defs/errorCode"},
        "retryable": {"type": "boolean"}
      },
      "unevaluatedProperties": false
    },
    "usageContext": {
      "type": "object",
      "required": ["runRef"],
      "properties": {
        "runRef": {"type": "string", "minLength": 1, "maxLength": 256},
        "invocationId": {"type": "string", "minLength": 1, "maxLength": 256},
        "snapshotUseId": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "unevaluatedProperties": false
    },
    "selectionLimits": {
      "type": "object",
      "required": ["profile", "maxFragments", "maxBytes", "maxBytesPerFragment", "maxAssets", "tokenBudget"],
      "properties": {
        "profile": {"$ref": "#/$defs/profileId"},
        "maxFragments": {"type": "integer", "minimum": 1, "maximum": 64},
        "maxBytes": {"type": "integer", "minimum": 1, "maximum": 262144},
        "maxBytesPerFragment": {"type": "integer", "minimum": 1, "maximum": 262144},
        "maxAssets": {"type": "integer", "minimum": 0, "maximum": 16},
        "tokenBudget": {
          "type": ["object", "null"],
          "required": ["tokenizerId", "tokenizerVersion", "vocabularyDigest", "maxTokens"],
          "properties": {
            "tokenizerId": {"$ref": "#/$defs/name"},
            "tokenizerVersion": {"type": "string", "minLength": 1, "maxLength": 64},
            "vocabularyDigest": {"$ref": "#/$defs/sha256"},
            "maxTokens": {"type": "integer", "minimum": 1, "maximum": 1048576}
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false,
      "x-knowkit-lessThan": {"code": "limit_exceeded", "orEqual": true, "pairs": [["maxBytesPerFragment", "maxBytes"]]}
    }
  }
}
